{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VagueHydro Agent prediction record",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "prediction": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  },
  "required": [
    "id",
    "prediction"
  ]
}
