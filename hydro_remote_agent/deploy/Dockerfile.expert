FROM pytorch/pytorch:2.0.1-cuda11.8-cudnn8-runtime

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app

COPY hydro_remote_agent/deploy/requirements-expert.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY hydro_remote_agent /app/hydro_remote_agent
COPY hydro_program3d /app/hydro_program3d
COPY wcs_unified /app/wcs_unified

CMD ["python", "-m", "hydro_remote_agent.tools.expert_worker_ws", "--runtime", "/app/hydro_remote_agent/deploy/expert_runtime.container.yaml", "--work-dir", "/data/expert_outputs"]
