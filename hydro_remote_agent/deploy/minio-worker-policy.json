{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::hydro-input",
        "arn:aws:s3:::hydro-output",
        "arn:aws:s3:::hydro-intermediate",
        "arn:aws:s3:::hydro-models"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::hydro-input/*",
        "arn:aws:s3:::hydro-models/*",
        "arn:aws:s3:::hydro-intermediate/*",
        "arn:aws:s3:::hydro-output/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::hydro-intermediate/*",
        "arn:aws:s3:::hydro-output/*"
      ]
    }
  ]
}
