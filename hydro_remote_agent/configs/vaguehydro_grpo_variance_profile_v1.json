{
  "schema_version": "vaguehydro.grpo_variance_profile.v1",
  "purpose": "pre_registered_inference_only_reward_variance_profile",
  "seed": 20261003,
  "base_model": "/models/Qwen3-VL-8B-Instruct",
  "sft_adapter": "runs/hydro_remote_agent/qwen3_vl_8b_lora_v1",
  "train_source": "hydro_remote_agent/data/vague_hydro_sft_v2/train_curriculum_16360.jsonl",
  "tool_registry": "hydro_remote_agent/configs/tool_registry.yaml",
  "output": "runs/hydro_remote_agent/vaguehydro_grpo_variance_profile_v1",
  "sampling": {
    "group_size": 4,
    "temperature": 2.0,
    "top_p": 0.98,
    "max_new_tokens": 256,
    "do_sample": true,
    "action_types": ["direct_answer", "tool_call", "workflow"],
    "requested_but_absent_action_types": ["clarification", "abstain"],
    "difficulty_mapping": {"L0": "easy", "L1": "medium", "L2": "hard", "L3": "hard"},
    "quota_per_action_difficulty_cell": 3,
    "total_samples": 27,
    "parameter_complexity_bins": {"low_max": 2, "medium_max": 5},
    "parameter_target_cycle": ["low", "medium", "high"],
    "language_target_cycle": ["zh", "en", "zh"],
    "region_target_cycle": ["00", "01", "02"]
  },
  "reward": {
    "implementation": "GoldActionReward",
    "weights": {"schema": 0.2, "action": 0.2, "tool": 0.2, "argument": 0.2, "workflow": 0.15, "stop": 0.05},
    "components": ["schema", "action", "tool", "argument", "workflow", "stop"]
  },
  "decoder": {
    "implementation": "SchemaConstrainedLogitsProcessor",
    "initial_scan_top_tokens": 512,
    "fallback_scan_top_tokens": 8192,
    "eos_only_after_valid_agent_request": true
  },
  "preregistered_gate": {
    "overall_fraction_groups_std_gt_zero_min": 0.30,
    "minimum_stable_variance_strata": 2,
    "stability_stratum_dimensions": ["action_type", "difficulty", "parameter_complexity"],
    "stable_stratum_min_groups": 3,
    "stable_stratum_fraction_std_gt_zero_min": 0.30,
    "std_epsilon": 1e-12
  },
  "constraints": {
    "formal_training": false,
    "optimizer": false,
    "gradient_updates": false,
    "adapter_updates": false,
    "verifier": false,
    "real_experts": false,
    "frozen_test_reads": false,
    "posthoc_sampling_changes": false,
    "posthoc_threshold_changes": false
  }
}
