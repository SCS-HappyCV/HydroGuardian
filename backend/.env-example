# Copy this file to `.env` before running docker compose from the `backend/` directory.
#
# Minimal LLM setup:
# - Leave OPENAI_API_KEY empty to use rule-based task parsing fallback only.
# - Set OPENAI_API_KEY to enable OpenAI-compatible LLM task parsing.

# OpenAI / OpenAI-compatible endpoint used by agent-service task parsing.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# DashScope/Qwen-compatible option. You can either set OPENAI_API_KEY to your
# DashScope key, or set DASHSCOPE_API_KEY and leave OPENAI_API_KEY empty.
DASHSCOPE_API_KEY=

# agent-service task parser.
# Supported backends:
# - auto: try LLM tool-call parsing first, then fall back to rules on failure.
# - openai: use LLM tool-call parsing first.
# - rule: use local rule parser only.
AGENT_TASK_PARSER_BACKEND=auto
AGENT_TASK_PARSER_MODEL=gpt-5.5
AGENT_TASK_PARSER_MAX_TOKENS=500
AGENT_TASK_PARSER_DISABLE_THINKING=false
AGENT_TASK_PARSER_FALLBACK_TO_RULE=true

# Example for the previous Qwen/DashScope compiler setup:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=sk-...
# AGENT_TASK_PARSER_MODEL=qwen3.5-flash
# AGENT_TASK_PARSER_MAX_TOKENS=1200
# AGENT_TASK_PARSER_DISABLE_THINKING=true
