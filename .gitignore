target/
.idea/
*.iml
.DS_Store
*.log

# Runtime middleware data generated by docker compose
backend/data/**/data/**
!backend/data/**/data/.gitkeep
backend/data/nacos/logs/**
!backend/data/nacos/logs/.gitkeep
backend/data/minio/conf/**
!backend/data/minio/conf/.gitkeep

# Generated proto code in agent-service dev mode
backend/services/agent-service/src/*_pb2.py
backend/services/agent-service/src/*_pb2_grpc.py
backend/services/agent-service/src/__pycache__/
backend/services/agent-service/__pycache__/
