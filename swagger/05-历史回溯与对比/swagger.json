{
  "openapi": "3.0.3",
  "info": {
    "title": "历史回溯与对比接口",
    "version": "0.1.0",
    "description": "对应历史回溯、执行回放、结果差异对比。"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "History"
    }
  ],
  "paths": {
    "/api/v1/history/tasks": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "查询历史任务列表",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "keyword",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryTaskPageResponse"
                },
                "example": {
                  "code": "0",
                  "message": "OK",
                  "traceId": "trace-20260526-401",
                  "data": {
                    "page": 0,
                    "pageSize": 0,
                    "total": 0,
                    "items": [
                      {
                        "taskId": "task-1001",
                        "taskName": "滨海泵站夜巡分析",
                        "finishedAt": "2026-05-26T10:00:00Z",
                        "status": "success"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history/tasks/{taskId}/playback": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "获取任务回放详情",
        "parameters": [
          {
            "in": "path",
            "name": "taskId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaybackResponse"
                },
                "example": {
                  "code": "0",
                  "message": "OK",
                  "traceId": "trace-20260526-401",
                  "data": {
                    "taskId": "string",
                    "timeline": [
                      {
                        "step": "风险评估",
                        "startedAt": "2026-05-26T10:00:00Z",
                        "finishedAt": "2026-05-26T10:00:00Z",
                        "outputSummary": "string"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history/compare": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "对比两个任务结果",
        "parameters": [
          {
            "in": "query",
            "name": "baseTaskId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "targetTaskId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryCompareResponse"
                },
                "example": {
                  "code": "0",
                  "message": "OK",
                  "traceId": "trace-20260526-401",
                  "data": {
                    "baseTaskId": "string",
                    "targetTaskId": "string",
                    "summary": {
                      "addedRisks": 2,
                      "removedRisks": 1,
                      "changedRisks": 3
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history/risk-diff": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "获取风险差异卡片数据",
        "parameters": [
          {
            "in": "query",
            "name": "baseTaskId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "targetTaskId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskDiffResponse"
                },
                "example": {
                  "code": "0",
                  "message": "OK",
                  "traceId": "trace-20260526-401",
                  "data": [
                    {
                      "riskId": "string",
                      "changeType": "added",
                      "beforeLevel": "string",
                      "afterLevel": "string"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "0"
          },
          "message": {
            "type": "string",
            "example": "OK"
          },
          "traceId": {
            "type": "string",
            "example": "trace-20260526-401"
          }
        }
      },
      "HistoryTask": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "example": "task-1001"
          },
          "taskName": {
            "type": "string",
            "example": "滨海泵站夜巡分析"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ]
          }
        }
      },
      "HistoryTaskPageResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer"
                  },
                  "pageSize": {
                    "type": "integer"
                  },
                  "total": {
                    "type": "integer"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/HistoryTask"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "PlaybackNode": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "example": "风险评估"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "outputSummary": {
            "type": "string"
          }
        }
      },
      "PlaybackResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "taskId": {
                    "type": "string"
                  },
                  "timeline": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PlaybackNode"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "HistoryCompareResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "baseTaskId": {
                    "type": "string"
                  },
                  "targetTaskId": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "object",
                    "properties": {
                      "addedRisks": {
                        "type": "integer",
                        "example": 2
                      },
                      "removedRisks": {
                        "type": "integer",
                        "example": 1
                      },
                      "changedRisks": {
                        "type": "integer",
                        "example": 3
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "RiskDiffItem": {
        "type": "object",
        "properties": {
          "riskId": {
            "type": "string"
          },
          "changeType": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "changed"
            ]
          },
          "beforeLevel": {
            "type": "string",
            "nullable": true
          },
          "afterLevel": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RiskDiffResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RiskDiffItem"
                }
              }
            }
          }
        ]
      }
    }
  }
}
